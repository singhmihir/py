flowchart TD
    classDef tbl fill:#EEF1F5,stroke:#9AA0A6,color:#111
    classDef chk fill:#FFF6DC,stroke:#C9A227,color:#111
    classDef stop fill:#FBE9E7,stroke:#C0392B,color:#111
    classDef win fill:#E6F4EA,stroke:#2E7D32,color:#111

    A["Qualys host record<br/>IP, DNS, OS"] --> B{"IP present,<br/>not 127.x, not 169.254.x?"}
    B -- no --> S0(["null: next rule"]):::stop
    B -- yes --> C["Notes: ip, dns, label, os<br/>ignore list = sn_sec_cmn.ignoreCIClass"]
    C --> D{"VIP sign?<br/>OS contains f5, big-ip, big ip, netscaler<br/>or a label segment is vip / vs"}:::chk
    D -- no --> S1(["null: not a virtual IP"]):::stop

    D -- yes --> E[("cmdb_ci_lb_service<br/>Load Balancer Service, the desk")]:::tbl
    E --> F["Clues in order:<br/>1 fqdn = DNS name<br/>2 name = DNS name<br/>3 name = label<br/>4 ip_address = IP<br/>(ignored classes left out)"]
    F --> G{"rows for the clue?"}:::chk
    G -- "none" --> F
    G -- "two or more" --> S2(["null: never guess"]):::stop
    G -- "no clue left" --> S2
    G -- "exactly one" --> H["service = the desk record"]

    H --> P[("cmdb_ci_lb_pool<br/>Load Balancer Pool")]:::tbl
    P --> P1["pools =<br/>service.pool field<br/>+ pools whose service field = desk<br/>+ pools related to the desk (cmdb_rel_ci, either direction)"]
    P1 --> P2{"any pool?"}:::chk
    P2 -- no --> S3(["null: no room list;<br/>rule 460 attaches the desk"]):::stop

    P2 -- yes --> M[("cmdb_ci_lb_pool_member<br/>Load Balancer Pool Member")]:::tbl
    M --> M1["members =<br/>members whose pool field is one of the pools<br/>+ members related to a pool (cmdb_rel_ci)<br/>each kept with its ip_address<br/>(empty address kept as empty text)"]
    M1 --> M2{"any member?"}:::chk
    M2 -- no --> S4(["null: empty room list;<br/>rule 460 attaches the desk"]):::stop

    M2 -- yes --> R["for each member address"]
    R --> T1[("cmdb_ci_hardware<br/>ip_address = member address")]:::tbl
    R --> T2[("cmdb_ci_network_adapter<br/>ip_address = member address<br/>-> owner cmdb_ci")]:::tbl
    R --> T3[("cmdb_ci_ip_address<br/>ip_address = member address<br/>-> nic.cmdb_ci")]:::tbl
    R --> T4[("cmdb_rel_ci<br/>member related to hardware")]:::tbl
    T1 --> K
    T2 --> K
    T3 --> K
    T4 --> K
    K{"keep only a real server:<br/>in the cmdb_ci_hardware tree,<br/>not an ignored class,<br/>not cmdb_ci_lb (balancer device)"}:::chk
    K --> N["distinct servers found"]
    N --> Q{"how many?"}:::chk
    Q -- "0" --> S5(["null: rooms lead nowhere;<br/>rule 460 attaches the desk"]):::stop
    Q -- "2 or more" --> S6(["null: shared pool;<br/>rule 460 attaches the desk"]):::stop
    Q -- "exactly 1" --> W(["return the server:<br/>the real CI"]):::win
