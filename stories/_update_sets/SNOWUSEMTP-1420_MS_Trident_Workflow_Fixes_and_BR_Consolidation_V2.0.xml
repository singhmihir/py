<payload>&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;record_update sys_domain="global" table="sys_script"&gt;&lt;sys_script action="INSERT_OR_UPDATE"&gt;&lt;abort_action&gt;false&lt;/abort_action&gt;&lt;access&gt;package_private&lt;/access&gt;&lt;action_delete&gt;false&lt;/action_delete&gt;&lt;action_insert&gt;false&lt;/action_insert&gt;&lt;action_query&gt;false&lt;/action_query&gt;&lt;action_update&gt;true&lt;/action_update&gt;&lt;active&gt;true&lt;/active&gt;&lt;add_message&gt;false&lt;/add_message&gt;&lt;advanced&gt;true&lt;/advanced&gt;&lt;change_fields&gt;false&lt;/change_fields&gt;&lt;client_callable&gt;false&lt;/client_callable&gt;&lt;collection&gt;sn_vulc_result_group&lt;/collection&gt;&lt;condition/&gt;&lt;description&gt;Single governance rule for Trident remediation tasks. Replaces: Trident Recopen From Resolved, BOFA Trident closure approval gate, BOFA Trident reopen window, BOFA Trident start workflow. Branches in a fixed order: close gate (evidence + approved request), reopen window, closure request on resolve (staged on the current write, no nested update), and cancellation of open approvals when a pending request is backed out.&lt;/description&gt;&lt;execute_function&gt;false&lt;/execute_function&gt;&lt;filter_condition table="sn_vulc_result_group"&gt;stateVALCHANGES^EQ&lt;item endquery="false" field="state" goto="false" newquery="false" operator="VALCHANGES" or="false" value=""/&gt;&lt;item endquery="true" field="" goto="false" newquery="false" operator="=" or="false" value=""/&gt;&lt;/filter_condition&gt;&lt;is_rest&gt;false&lt;/is_rest&gt;&lt;message/&gt;&lt;name&gt;BOFA Trident closure lifecycle&lt;/name&gt;&lt;order&gt;100&lt;/order&gt;&lt;priority&gt;100&lt;/priority&gt;&lt;rest_method/&gt;&lt;rest_method_text/&gt;&lt;rest_service/&gt;&lt;rest_service_text/&gt;&lt;rest_variables/&gt;&lt;role_conditions/&gt;&lt;script&gt;&lt;![CDATA[(function executeRule(current, previous) {
    var util = new sn_vulc.TridentClosureUtil();
    if (!util.isTridentTask(current))
        return;

    var closing   = current.getValue('state') == util.STATE_CLOSED &amp;&amp; previous.getValue('state') != util.STATE_CLOSED;
    var reopening = previous.getValue('state') == util.STATE_CLOSED &amp;&amp; current.getValue('state') != util.STATE_CLOSED;
    var resolving = current.getValue('state') == util.STATE_RESOLVED &amp;&amp; previous.getValue('state') != util.STATE_RESOLVED;

    // 1. Closing: only an approved closure request with evidence may close.
    if (closing) {
        if (!util.hasEvidence(current)) {
            gs.addErrorMessage(util.MSG_NO_EVIDENCE);
            current.setAbortAction(true);
            return;
        }
        if (!util.closeApproved(current, previous)) {
            gs.addErrorMessage(util.MSG_NEEDS_APPROVAL);
            current.setAbortAction(true);
            return;
        }
        return;
    }

    // 2. Reopening a closed task: only within the reopen window.
    if (reopening) {
        if (!util.reopenAllowed(previous)) {
            gs.addErrorMessage('Reopening of Trident findings is only allowed up to ' + util.reopenWindowDays + ' days after closure.');
            current.setAbortAction(true);
            return;
        }
        current.setValue('approval', 'not requested');
        current.setValue('substate', '');
    }

    // 3. Resolving: stage the closure request; the flow picks it up from
    //    this one write. Without evidence the resolve is refused.
    if (resolving) {
        var outcome = util.applyClosureRequest(current);
        if (outcome == 'no_evidence') {
            gs.addErrorMessage(util.MSG_NO_EVIDENCE);
            current.setAbortAction(true);
        } else if (outcome == 'pending') {
            gs.addInfoMessage('A closure request is already awaiting approval for this remediation task.');
        } else {
            gs.addInfoMessage('Closure requested, the remediation task is now pending approval from the governance team.');
        }
        return;
    }

    // 4. Any other move away from a pending closure request cancels the
    //    open approvals so governance never votes on a stale request.
    if (previous.getValue('substate') == util.PENDING_APPROVAL) {
        var cancelled = util.cancelOpenApprovals(current,
            'Approval cancelled: the remediation task was reopened before the governance decision was made.');
        current.setValue('substate', '');
        current.setValue('approval', 'not requested');
        if (cancelled &gt; 0)
            gs.addInfoMessage('The pending governance approval was cancelled because the remediation task was reopened.');
    }
})(current, previous);
]]&gt;&lt;/script&gt;&lt;sys_class_name&gt;sys_script&lt;/sys_class_name&gt;&lt;sys_created_by&gt;admin&lt;/sys_created_by&gt;&lt;sys_created_on&gt;2026-08-26 10:11:55&lt;/sys_created_on&gt;&lt;sys_domain&gt;global&lt;/sys_domain&gt;&lt;sys_domain_path&gt;/&lt;/sys_domain_path&gt;&lt;sys_id&gt;669be2b7933643d0e3aef0aefaba107b&lt;/sys_id&gt;&lt;sys_mod_count&gt;0&lt;/sys_mod_count&gt;&lt;sys_name&gt;BOFA Trident closure lifecycle&lt;/sys_name&gt;&lt;sys_overrides/&gt;&lt;sys_package display_value="Configuration Compliance" source="sn_vulc"&gt;29691e1f0212471dad08668c1e39932b&lt;/sys_package&gt;&lt;sys_policy/&gt;&lt;sys_scope display_value="Configuration Compliance"&gt;29691e1f0212471dad08668c1e39932b&lt;/sys_scope&gt;&lt;sys_update_name&gt;sys_script_669be2b7933643d0e3aef0aefaba107b&lt;/sys_update_name&gt;&lt;sys_updated_by&gt;admin&lt;/sys_updated_by&gt;&lt;sys_updated_on&gt;2026-08-26 10:11:55&lt;/sys_updated_on&gt;&lt;template/&gt;&lt;when&gt;before&lt;/when&gt;&lt;/sys_script&gt;&lt;sys_translated_text action="delete_multiple" query="documentkey=669be2b7933643d0e3aef0aefaba107b"/&gt;&lt;/record_update&gt;</payload>
