 "policyLoop": [
  "_getPolicyIds: function() {",
  "    var policyIds = [];",
  "    var gr = new GlideRecord(\"sn_vulc_policy\");",
  "    gr.addQuery(\"source\", this._SOURCE);",
  "    gr.addQuery(\"is_deprecated\", \"false\");",
  "    gr.addQuery(\"active\", \"true\");",
  "    gr.addNotNullQuery(\"source_id_int\");",
  "    gr.orderBy(\"source_id_int\");",
  "    gr.query();",
  "    while (gr.next()) {",
  "        policyIds.push(gr.getValue(\"source_id_int\"));",
  "    }",
  "    return policyIds;",
  "},",
  "",
  "parameters.pending = this._getPolicyIds();",
  "parameters.processing = parameters.pending[0];",
  "parameters.pending.splice(0, 1);"
 ],
